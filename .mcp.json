{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/chrome-devtools-mcp.mjs",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--allowed-url-pattern=http://127.0.0.1:5173/*",
        "--allowed-url-pattern=http://localhost:5173/*",
        "--allowed-url-pattern=ws://127.0.0.1:5173/*",
        "--allowed-url-pattern=ws://localhost:5173/*",
        "--allowed-url-pattern=about\\:blank"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
